# ── Compiled output ───────────────────────────────────────────────────────────
/dist
/tmp
/out-tsc

# ── Node modules ─────────────────────────────────────────────────────────────
node_modules/

# ── Angular cache ────────────────────────────────────────────────────────────
.angular/

# ── Environment files (never commit real secrets) ────────────────────────────
src/environments/environment.prod.ts

# ── Dependency lock (keep package-lock.json, ignore yarn) ────────────────────
yarn.lock
.yarn-integrity

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Test / coverage output ────────────────────────────────────────────────────
/coverage
*.lcov
.nyc_output

# ── TypeScript build info ─────────────────────────────────────────────────────
*.tsbuildinfo

# ── ESLint / Prettier cache ───────────────────────────────────────────────────
.eslintcache
.stylelintcache
.prettier_cache

# ── npm / package manager ─────────────────────────────────────────────────────
.npm
.npmrc.local
.pnpm-store

# ── OS generated files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Misc ──────────────────────────────────────────────────────────────────────
*.tgz
.cache
.parcel-cache
